        self.clearContainer(self.navRail)
        brandBox = tk.Frame(self.navRail, bg=palette["railCardBg"], padx=14, pady=14)
        brandBox.grid(row=0, column=0, sticky="ew", padx=12, pady=(14, 10))
        brandBox.grid_columnconfigure(0, weight=1)

        tk.Label(
            brandBox,
            text="Code Lab University",
            font=("Georgia", 8, "bold"),
            bg=palette["railCardBg"],
            fg=palette["railMuted"],
            anchor="w",
        ).grid(row=0, column=0, sticky="w")
        tk.Label(
            brandBox,
            text="Student Manager",
            font=("Georgia", 13, "bold"),
            bg=palette["railCardBg"],
            fg=palette["railText"],
            anchor="w",
        ).grid(row=1, column=0, sticky="w", pady=(2, 0))

        navItems = [
            ("overview", "Dashboard Overview", self.showOverviewDashboard, False),
            ("all", "View All Records", self.viewAllRecords, False),
            ("lookup", "Individual Record", self.showLookupView, False),
            ("highest", "Highest Score", self.showHighestStudent, False),
            ("lowest", "Lowest Score", self.showLowestStudent, False),
            ("sort", "Sort Records", self.showSortView, False),
            ("add", "Add Student", lambda: self.runOrAuthAdminAction("Add Student", self.showAddView), True),
            ("delete", "Delete Student", lambda: self.runOrAuthAdminAction("Delete Student", self.showDeleteView), True),
            ("update", "Update Student", lambda: self.runOrAuthAdminAction("Update Student", self.showUpdateSelectView), True),
        ]

        navButtonFont = ("Georgia", 10, "bold")
        for idx, (itemKey, itemLabel, itemCmd, requiresAdmin) in enumerate(navItems, start=1):
            isSelected = itemKey == activeKey
            btnDisabled = locked and requiresAdmin
            if btnDisabled:
                btnFg = palette["railMuted"]
            elif isSelected:
                btnFg = palette["railSelectedText"]
            else:
                btnFg = palette["railText"]

            itemBtn = tk.Button(
                self.navRail,
                text=itemLabel,
                font=navButtonFont,
                bg=palette["railActiveBg"] if isSelected else palette["railBg"],
                fg=btnFg,
                disabledforeground=palette["railMuted"],
                activebackground=palette["railActiveBg"],
                activeforeground=palette["railSelectedText"] if isSelected else palette["railText"],
                relief=tk.FLAT,
                bd=0,
                anchor="w",
                cursor="hand2" if not btnDisabled else "arrow",
                state="disabled" if btnDisabled else "normal",
                padx=12,
                pady=6,
                command=itemCmd,
            )
            itemBtn.grid(row=idx, column=0, sticky="ew", padx=10, pady=1)

        if locked:
            sessionBtnLabel = "Reset Lockout"
            sessionBtnCmd = self.resetAdminLockout
        elif self.isAdminSessionUnlocked:
            sessionBtnLabel = "Lock Admin"
            sessionBtnCmd = self.lockAdminSession
        else:
            sessionBtnLabel = "Unlock Admin"
            sessionBtnCmd = lambda: self.promptAdminTwoFactorAuth("Admin Session", self.refreshCurrentView)

        sessionBtn = tk.Button(
            self.navRail,
            text=sessionBtnLabel,
            font=("Georgia", 9, "bold"),
            bg=palette["railCardBg"],
            fg=palette["railText"],
            activebackground=palette["railActiveBg"],
            activeforeground=palette["railSelectedText"],
            relief=tk.FLAT,
            bd=0,
            cursor="hand2",
            padx=12,
            pady=6,
            command=sessionBtnCmd,
        )
        sessionBtn.grid(row=10, column=0, sticky="ew", padx=12, pady=(10, 2))

        exitRailBtn = tk.Button(
            self.navRail,
            text="Exit Application",
            font=("Georgia", 9, "bold"),
            bg=palette["railCardBg"],
            fg=palette["railMuted"],
            activebackground=palette["railActiveBg"],
            activeforeground=palette["railText"],
            relief=tk.FLAT,
            bd=0,
            cursor="hand2",
            padx=12,
            pady=6,
            command=self.rootWindow.destroy,
        )
        exitRailBtn.grid(row=11, column=0, sticky="ew", padx=12, pady=(4, 14))

        self.clearContainer(self.topBar)
        titleBlock = tk.Frame(self.topBar, bg=palette["topBarBg"])
        titleBlock.grid(row=0, column=0, sticky="w")

        tk.Label(
            titleBlock,
            text=pageTitle,
            font=("Georgia", 15, "bold"),
            bg=palette["topBarBg"],
            fg=palette["headingText"],
        ).grid(row=0, column=0, sticky="w")
        tk.Label(
            titleBlock,
            text=pageSubtitle,
            font=("Georgia", 9),
            bg=palette["topBarBg"],
            fg=palette["mutedText"],
        ).grid(row=1, column=0, sticky="w")

        controlsBlock = tk.Frame(self.topBar, bg=palette["topBarBg"])
        controlsBlock.grid(row=0, column=1, sticky="e")

        syncLabel = "Unsaved Changes" if self.hasUnsavedChanges else "Synced"
        syncFg = palette["errorText"] if self.hasUnsavedChanges else palette["successBtnFg"]
        syncBg = palette["dangerBtnBg"] if self.hasUnsavedChanges else palette["successBtnBg"]
        tk.Label(
            controlsBlock,
            text=syncLabel,
            font=("Georgia", 8, "bold"),
            bg=syncBg,
            fg=syncFg,
            padx=8,
            pady=4,
        ).grid(row=0, column=0, padx=(0, 8))

        undoState = "normal" if self.undoStack else "disabled"
        self.createActionButton(
            controlsBlock,
            "Undo (" + str(len(self.undoStack)) + ")",
            self.undoLastChange,
            variant="secondary",
            padyVal=5,
            state=undoState,
        ).grid(row=0, column=1, padx=(0, 8))

        themeToggleLabel = "Dark Mode" if self.currentTheme == "lightMode" else "Light Mode"
        self.createActionButton(
            controlsBlock,
            themeToggleLabel,
            self.toggleThemeMode,
            variant="secondary",
            padyVal=5,
        ).grid(row=0, column=2, padx=(0, 8))