    def generateTwoFactorCode(self):
        return str(random.randint(0, 999999)).zfill(6)

    def isLockedOut(self):
        return self.isAdminLockedOut or self.failedPasswordAttempts >= self.maxPasswordAttempts

    def handleLockedOutState(self):
        self.isAdminLockedOut = True
        self.statusText = "Admin access locked after " + str(self.maxPasswordAttempts) + " failed password attempts"
        messagebox.showerror(
            "Account Locked",
            "Too many incorrect admin password attempts (" + str(self.maxPasswordAttempts) + " max). Admin actions are locked.",
        )
        self.refreshCurrentView()

    def lockAdminSession(self):
        self.isAdminSessionUnlocked = False
        self.statusText = "Admin session locked"
        self.refreshCurrentView()

    def resetAdminLockout(self):
        self.isAdminLockedOut = False
        self.failedPasswordAttempts = 0
        self.isAdminSessionUnlocked = False
        self.statusText = "Admin lockout reset. 2FA required for admin actions"
        messagebox.showinfo("Lockout Reset", "Admin lockout has been reset.")
        self.refreshCurrentView()

    def runOrAuthAdminAction(self, actionName, onVerified):
        if self.isLockedOut():
            self.handleLockedOutState()
            return

        if self.isAdminSessionUnlocked:
            self.statusText = "Admin session active: Opening " + actionName
            onVerified()
            return

        self.promptAdminTwoFactorAuth(actionName, onVerified)

