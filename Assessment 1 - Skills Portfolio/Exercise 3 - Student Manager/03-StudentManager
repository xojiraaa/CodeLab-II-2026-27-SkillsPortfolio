    maxTotalMarks = 160

    def getCourseworkTotal(self, studentItem):
        return studentItem["cw1"] + studentItem["cw2"] + studentItem["cw3"]

    def getOverallTotal(self, studentItem):
        return self.getCourseworkTotal(studentItem) + studentItem["exam"]

    def getOverallPercentage(self, studentItem):
        return (self.getOverallTotal(studentItem) / self.maxTotalMarks) * 100.0

    def getGradeLetter(self, percentageVal):
        if percentageVal >= 70:
            return "A"
        elif percentageVal >= 60:
            return "B"
        elif percentageVal >= 50:
            return "C"
        elif percentageVal >= 40:
            return "D"
        return "F"

    def getStudentGrade(self, studentItem):
        return self.getGradeLetter(self.getOverallPercentage(studentItem))

    def getClassAveragePercentage(self, recordsList=None):
        targetList = self.studentList if recordsList is None else recordsList
        if not targetList:
            return 0.0
        return sum(self.getOverallPercentage(s) for s in targetList) / len(targetList)

    def getGradeBreakdown(self, recordsList=None):
        targetList = self.studentList if recordsList is None else recordsList
        counts = {"A": 0, "B": 0, "C": 0, "D": 0, "F": 0}
        for studentItem in targetList:
            gradeKey = self.getStudentGrade(studentItem)
            counts[gradeKey] = counts.get(gradeKey, 0) + 1
        return counts

    def getPassRate(self, recordsList=None):
        targetList = self.studentList if recordsList is None else recordsList
        if not targetList:
            return 0.0
        passedCount = sum(1 for s in targetList if self.getOverallPercentage(s) >= 40.0)
        return (passedCount / len(targetList)) * 100.0

    def filterStudentRecords(self, queryText="", gradeFilter="All"):
        cleanedQuery = queryText.strip().lower()
        filtered = []
        for studentItem in self.studentList:
            studentGrade = self.getStudentGrade(studentItem)
            if gradeFilter != "All" and studentGrade != gradeFilter:
                continue
            if cleanedQuery:
                matchesName = cleanedQuery in studentItem["name"].lower()
                matchesCode = cleanedQuery in str(studentItem["code"])
                matchesGrade = cleanedQuery == studentGrade.lower()
                if not (matchesName or matchesCode or matchesGrade):
                    continue
            filtered.append(studentItem)
        return filtered

    def formatStudentRecord(self, studentItem):
        cwTotal = self.getCourseworkTotal(studentItem)
        overallScore = self.getOverallTotal(studentItem)
        pctVal = self.getOverallPercentage(studentItem)
        gradeVal = self.getGradeLetter(pctVal)

        return (
            "Name: " + studentItem["name"] + "   |   Student No: " + str(studentItem["code"]) + "\n"
            "  Coursework Marks : " + str(studentItem["cw1"]) + ", " + str(studentItem["cw2"]) + ", " + str(studentItem["cw3"])
            + "  (Total Coursework: " + str(cwTotal) + "/60)\n"
            "  Examination Mark : " + str(studentItem["exam"]) + "/100   |   Overall Score: " + str(overallScore) + "/160\n"
            "  Overall Percentage: " + f"{pctVal:.2f}%" + "   |   Grade: " + gradeVal + "\n"
            + ("-" * 72) + "\n"
        )

    def buildReportContent(self, recordsList, includeSummary=False):
        if not recordsList:
            return "No matching student records available.\n"

        reportText = ""
        for studentItem in recordsList:
            reportText += self.formatStudentRecord(studentItem)

        if includeSummary:
            classSize = len(recordsList)
            avgPct = self.getClassAveragePercentage(recordsList)
            passRate = self.getPassRate(recordsList)
            gradeCounts = self.getGradeBreakdown(recordsList)
            reportText += "\nCLASS SUMMARY\n"
            reportText += "  Number of Students in Class : " + str(classSize) + "\n"
            reportText += "  Average Percentage Mark     : " + f"{avgPct:.2f}%" + "\n"
            reportText += "  Pass Rate (40%+ overall)    : " + f"{passRate:.1f}%" + "\n"
            reportText += (
                "  Grade Breakdown             : "
                + "A:" + str(gradeCounts["A"]) + "  |  "
                + "B:" + str(gradeCounts["B"]) + "  |  "
                + "C:" + str(gradeCounts["C"]) + "  |  "
                + "D:" + str(gradeCounts["D"]) + "  |  "
                + "F:" + str(gradeCounts["F"]) + "\n"
            )

        return reportText

    def findStudent(self, queryInput):
        cleaned = queryInput.strip()
        if not cleaned:
            return None

        if cleaned.isdigit():
            targetCode = int(cleaned)
            for studentItem in self.studentList:
                if studentItem["code"] == targetCode:
                    return studentItem

        lowerQuery = cleaned.lower()
        for studentItem in self.studentList:
            if studentItem["name"].lower() == lowerQuery:
                return studentItem

        for studentItem in self.studentList:
            if lowerQuery in studentItem["name"].lower():
                return studentItem

        return None

    def recordUndoSnapshot(self):
        self.undoStack.append(cloneStudentRecords(self.studentList))

    def undoLastChange(self):
        if not self.undoStack:
            messagebox.showinfo("Nothing to Undo", "No previous student record changes to undo.")
            return

        previousList = self.undoStack.pop()
        self.studentList = previousList
        if self.persistChanges("Undid last change"):
            messagebox.showinfo("Undone", "Restored previous student records and updated studentMarks.txt.")
            self.refreshCurrentView()

    def exportReportToFile(self, reportBody, defaultName="student_report.txt"):
        chosenPath = filedialog.asksaveasfilename(
            title="Export Report",
            initialfile=defaultName,
            defaultextension=".txt",
            filetypes=[("Text Files", "*.txt"), ("All Files", "*.*")],
        )
        if not chosenPath:
            return

        try:
            outFile = Path(chosenPath)
            outFile.write_text(reportBody, encoding="utf-8")
            self.statusText = "Exported report to " + outFile.name
            messagebox.showinfo("Exported", "Report saved to:\n" + str(outFile))
        except Exception as exportErr:
            messagebox.showerror("Export Error", "Could not save report:\n" + str(exportErr))

    def persistChanges(self, actionNote):
        try:
            writeStudentData(self.filePath, self.studentList)
            self.headerCount = len(self.studentList)
            self.hasUnsavedChanges = False
            self.statusText = actionNote + " • " + str(len(self.studentList)) + " saved to studentMarks.txt"
            return True
        except Exception as saveErr:
            self.hasUnsavedChanges = True
            messagebox.showerror("Save Error", "Failed to save studentMarks.txt:\n" + str(saveErr))
            return False

    def reloadFromDisk(self):
        if self.hasUnsavedChanges:
            proceed = messagebox.askyesno(
                "Unsaved Changes",
                "Reloading from disk will overwrite unsaved state. Continue?",
            )
            if not proceed:
                return

        try:
            loadedList, headerNum = loadStudentData(self.filePath)
            self.studentList = loadedList
            self.headerCount = headerNum
            self.hasUnsavedChanges = False
            self.undoStack.clear()
            self.statusText = "Reloaded " + str(len(self.studentList)) + " record(s) from file"
            messagebox.showinfo("Reloaded", "Loaded " + str(len(self.studentList)) + " record(s).")
        except Exception as loadErr:
            messagebox.showerror("Reload Error", str(loadErr))
        self.refreshCurrentView()

